{
  "name": "agents-viewer",
  "displayName": "Agents Viewer",
  "description": "A local, read-only dashboard for your AI coding agents: Claude Code, Codex and Gemini CLI. Available agents, orchestrator → sub-agent hierarchy and live status, across every project.",
  "version": "0.4.0",
  "publisher": "lecuistotduweb",
  "author": {
    "name": "lecuistotduweb",
    "url": "https://github.com/LeCuistotduWeb"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1b1d2e",
    "theme": "dark"
  },
  "keywords": [
    "agents",
    "ai agents",
    "dashboard",
    "monitoring",
    "subagents",
    "orchestrator",
    "multi-agent",
    "claude code",
    "codex",
    "gemini cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LeCuistotduWeb/agents-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/LeCuistotduWeb/agents-viewer/issues"
  },
  "homepage": "https://github.com/LeCuistotduWeb/agents-viewer#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "l10n": "./l10n",
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentViewer",
          "title": "%viewsContainer.title%",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "agentViewer": [
        {
          "id": "agentViewer.available",
          "name": "%view.available.name%"
        },
        {
          "id": "agentViewer.sessions",
          "name": "%view.sessions.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "agentViewer.openGraph",
        "title": "%cmd.openGraph.title%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentViewer.refresh",
        "title": "%cmd.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "agentViewer.toggleScope",
        "title": "%cmd.toggleScope.title%",
        "icon": "$(globe)"
      },
      {
        "command": "agentViewer.openFile",
        "title": "%cmd.openFile.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentViewer.openGraph",
          "when": "view =~ /agentViewer\\./",
          "group": "navigation@0"
        },
        {
          "command": "agentViewer.refresh",
          "when": "view =~ /agentViewer\\./",
          "group": "navigation"
        },
        {
          "command": "agentViewer.toggleScope",
          "when": "view == agentViewer.sessions",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "agentViewer.openFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "agentViewer.providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "gemini"
            ]
          },
          "default": [
            "claude",
            "codex",
            "gemini"
          ],
          "description": "%config.providers.desc%"
        },
        "agentViewer.claude.dir": {
          "type": "string",
          "default": "",
          "description": "%config.claude.dir.desc%"
        },
        "agentViewer.codex.dir": {
          "type": "string",
          "default": "",
          "description": "%config.codex.dir.desc%"
        },
        "agentViewer.gemini.dir": {
          "type": "string",
          "default": "",
          "description": "%config.gemini.dir.desc%"
        },
        "agentViewer.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "description": "%config.scope.desc%"
        },
        "agentViewer.activeThresholdSeconds": {
          "type": "number",
          "default": 30,
          "description": "%config.activeThreshold.desc%"
        },
        "agentViewer.recentHours": {
          "type": "number",
          "default": 24,
          "description": "%config.recentHours.desc%"
        },
        "agentViewer.pollIntervalSeconds": {
          "type": "number",
          "default": 3,
          "description": "%config.pollInterval.desc%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node out/test/smoke.js",
    "diagnose": "npm run compile && node out/diagnose.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
